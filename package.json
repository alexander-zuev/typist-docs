{
  "name": "typist-docs",
  "version": "0.0.1",
  "private": true,
  "description": "Developer documentation for Typist",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check && nimbus-docs lint",
    "test": "playwright test",
    "lint": "oxlint . --quiet",
    "lint:fix": "oxlint . --fix --quiet",
    "lint:docs": "nimbus-docs lint",
    "lint:docs:fix": "nimbus-docs lint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "preview": "astro preview",
    "preview:cf": "wrangler dev",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/nimbus-docs": "^0.8.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@iconify-json/ph": "^1.2.2",
    "astro": "^7.1.3",
    "astro-icon": "^1.1.5",
    "astro-og-canvas": "^0.13.0",
    "canvaskit-wasm": "^0.41.1",
    "clsx": "^2.1.1",
    "posthog-js": "^1.407.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "lint-staged": "^17.2.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.114.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts,astro}": [
      "oxfmt --write --no-error-on-unmatched-pattern",
      "oxlint --fix"
    ],
    "*.{json,jsonc,yaml,yml,md,mdx,css}": [
      "oxfmt --write --no-error-on-unmatched-pattern"
    ]
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.5.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}
