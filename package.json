{
  "name": "typist-docs",
  "version": "0.0.1",
  "private": true,
  "description": "Developer documentation for Typist",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "lint": "oxlint . --quiet",
    "lint:fix": "oxlint . --fix --quiet",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "preview": "astro preview",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.4",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "astro": "^7.1.3",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.114.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.5.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
