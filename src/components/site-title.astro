---
import logo from '../assets/logo.svg'

const { siteTitleHref } = Astro.locals.starlightRoute
---

<a href={siteTitleHref} class="site-title sl-flex">
  <img src={logo.src} alt="" width={logo.width} height={logo.height} />
  <span class="site-label" translate="no">
    <span class="site-brand">Typist</span>
    <span class="site-product">Platform</span>
  </span>
</a>
