---
import { Icon } from 'astro-icon/components'

import logo from '@/assets/logo.svg'
import { Button } from '@/components/ui/button'
import { LinkButton } from '@/components/ui/link-button'
import { SearchTrigger } from '@/components/ui/search'
import { config } from 'virtual:nimbus/config'

interface Props {
  showSidebar?: boolean
}

const { showSidebar = true } = Astro.props
const isChangelog = Astro.url.pathname.startsWith('/changelog')
---

<header class="sticky top-0 z-30 border-b border-border bg-card/95 backdrop-blur">
  <div class="flex h-16 items-center">
    <div
      class="flex h-full min-w-0 items-center px-4 lg:w-(--nb-sidebar-width) lg:shrink-0 lg:border-r lg:border-border lg:px-6"
    >
      <a href="/" class="flex min-w-0 items-center gap-3 no-underline">
        <img src={logo.src} alt="" class="size-9 shrink-0" />
        <span class="truncate text-lg font-bold tracking-[-0.025em] text-foreground"
          >{config.title}</span
        >
      </a>
    </div>

    <nav class="hidden h-full items-center px-6 md:flex" aria-label="Platform">
      <a
        href="/changelog"
        aria-current={isChangelog ? 'page' : undefined}
        class="text-sm font-medium text-muted-foreground no-underline transition-colors hover:text-foreground aria-[current=page]:text-foreground"
      >
        Changelog
      </a>
    </nav>

    <div class="ml-auto flex items-center gap-2 px-4 lg:px-6">
      {config.search !== false && <SearchTrigger />}
      {
        config.github && (
          <LinkButton
            href={config.github}
            variant="minimal"
            shape="square"
            size="sm"
            aria-label="GitHub"
            target="_blank"
            rel="noopener"
            class="text-muted-foreground"
          >
            <Icon name="ph:github-logo" class="size-4" />
          </LinkButton>
        )
      }
      {
        showSidebar && (
          <Button
            variant="ghost"
            shape="square"
            size="sm"
            icon="ph:list"
            aria-label="Open navigation"
            data-menu-btn
            class="text-muted-foreground lg:hidden"
          />
        )
      }
    </div>
  </div>
</header>
