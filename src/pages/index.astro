---
import Header from '@/components/header.astro'
import SiteFooter from '@/components/site-footer.astro'
import { CardGrid } from '@/components/ui/card-grid'
import { LinkButton } from '@/components/ui/link-button'
import { LinkCard } from '@/components/ui/link-card'
import BaseLayout from '@/layouts/base-layout.astro'
---

<BaseLayout
  title="Typist Platform"
  description="Connect AI agents and developer tools to Typist."
>
  <div class="flex min-h-screen flex-col">
    <Header showSidebar={false} />
    <main id="main-content" class="mx-auto w-full max-w-4xl flex-1 px-6 py-16 lg:py-24">
      <h1
        class="max-w-2xl leading-tight text-foreground"
        style="font-size: 2.5rem; font-weight: 600; letter-spacing: -0.03em;"
      >
        Typist Developer Platform
      </h1>
      <p class="mt-3 max-w-2xl text-lg leading-relaxed text-muted-foreground">
        Programmatic access to your Typist transcripts. Start with MCP.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <LinkButton href="/mcp/quickstart" icon>Get started</LinkButton>
        {/* The platform needs a Typist account, and the header already carries
            the GitHub link, so the second CTA routes to the product instead. */}
        <LinkButton href="https://iamtypist.dev" variant="secondary" target="_blank" rel="noopener">
          Open Typist
        </LinkButton>
      </div>

      <section class="mt-16" aria-labelledby="mcp-heading">
        <p class="text-xs font-medium tracking-wide text-muted-foreground uppercase">
          Available now
        </p>
        <h2 id="mcp-heading" class="mt-1 text-2xl font-semibold tracking-tight text-foreground">
          Typist MCP
        </h2>
        <p class="mt-2 max-w-3xl leading-relaxed text-muted-foreground">
          Your agent reads your transcript library directly. Nothing to export, download, or paste.
        </p>
        {/* Routes rather than features: the tool surface is described on the
            overview page, and a landing card that cannot be clicked is dead
            weight next to it. */}
        <CardGrid class="mt-6">
          <LinkCard
            title="Quickstart"
            href="/mcp/quickstart"
            icon="ph:lightning"
            description="Connect Claude Code and ask your first question in two minutes."
          />
          <LinkCard
            title="Connect a client"
            href="/mcp/connect"
            icon="ph:plugs-connected"
            description="Claude, ChatGPT, Claude Code, Codex, Cursor, VS Code, and others."
          />
          <LinkCard
            title="Examples"
            href="/mcp/examples"
            icon="ph:sparkle"
            description="Prompts that search, summarize, and compare across recordings."
          />
        </CardGrid>
      </section>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
