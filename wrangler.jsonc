{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "typist-docs",
  "compatibility_date": "2026-07-25",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "routes": [
    {
      "pattern": "docs.iamtypist.dev",
      "custom_domain": true,
    },
  ],
}
