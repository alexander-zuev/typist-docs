{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["astro/client"]
  },
  "include": [".astro/types.d.ts", "**/*"],
  // The Worker is typed separately by src/server/tsconfig.json: its runtime types
  // replace the DOM lib, which would break every browser-side client script.
  "exclude": ["dist", "src/server", "worker-configuration.d.ts"]
}
